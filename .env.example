# ==========================================================================
# NGPL Tennis Ball Cricket Tournament — Frontend Environment Variables
# Copy to .env (never commit .env). Everything prefixed VITE_ is PUBLIC:
# it is bundled into browser JavaScript. NEVER put secrets here.
# ==========================================================================

# Google Apps Script web app URL (Deploy > Manage deployments > Web app URL).
# Required: without it, the site refuses registrations (nothing is stored locally).
# Example: https://script.google.com/macros/s/AKfycb.../exec
# Local testing against the mock backend: http://localhost:8787
VITE_BACKEND_URL=

# --------------------------------------------------------------------------
# NOT configured here (server-side only, see SETUP_GOOGLE_SHEETS.md):
#   - UPI receiver ID  -> PAYMENT_CONFIG.UPI_ID in apps-script/Code.gs
#   - ADMIN_KEY        -> Apps Script > Project Settings > Script Properties
#   - SPREADSHEET_ID   -> DEFAULT_SPREADSHEET_ID in Code.gs (Script Property overrides)
# No Google service-account key or private key is needed or used.
# --------------------------------------------------------------------------
